# Atlas — Environment Variables
# Copy this to .env.local and fill in your values

# Supabase (frontend uses anon key only — never use service key here)
NEXT_PUBLIC_SUPABASE_URL=https://qbbbuebbxueqclkrvoos.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# Tell Clerk where our sign-in/sign-up pages live
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Alpaca — credentials are stored per-user in broker_connections table (not env vars)

# Sprint 095: Atlas runs ZERO server-side LLM calls. All reasoning happens
# in the user's connected MCP client (Claude Desktop / ChatGPT). The
# GROQ_API_KEY and GOOGLE_GENERATIVE_AI_API_KEY env vars used in earlier
# sprints (028, etc.) are deliberately not declared here.

# Stripe (024-STRIPE-TIER-ENFORCEMENT)
# STRIPE_SECRET_KEY       → dashboard.stripe.com → Developers → API keys → Secret key
# STRIPE_WEBHOOK_SECRET   → dashboard.stripe.com → Developers → Webhooks → add endpoint
#                           URL: https://atlas-broker.vercel.app/api/webhooks/stripe
#                           Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
#                           Then copy the "Signing secret" shown after saving
# NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID → Stripe Dashboard → Products → create "Atlas Pro" → add Monthly price ($49) → copy price ID
# NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID  → same product → add Annual price ($39/mo = $468/yr) → copy price ID
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRO_MONTHLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_ANNUAL_PRICE_ID=

# App URL (used by MCP connector URL resolution — 026-MCP-INVESTOR-ROLLOUT)
# Set to the canonical deployment URL so the Claude connector shows the right endpoint
NEXT_PUBLIC_APP_URL=https://atlas-broker.vercel.app

# Sprint 109 Phase 1: signal evaluator cron. Vercel Cron sends this bearer
# token in the Authorization header. Generate with `openssl rand -hex 32`.
# In production, missing/wrong secret returns 401.
CRON_SECRET=

# Sprint 109 Phase 2: master encryption key for per-user spender private
# keys. AES-256-GCM encrypts each spender key at rest in Supabase before
# being written to user_spender_keys.encrypted_private_key. Generate with
# `openssl rand -hex 32` (must be exactly 64 hex chars = 32 bytes).
#
# Capstone-scope: env-var. Production upgrade is to move this into
# Supabase Vault (decrypted_secrets view or a Postgres function so the
# app runtime never sees plaintext master).
SPENDER_MASTER_KEY=
